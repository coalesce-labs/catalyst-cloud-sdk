{
  "openapi": "3.1.0",
  "info": {
    "title": "Catalyst Cloud API",
    "version": "0.46.0"
  },
  "paths": {
    "/api/v1/flow-series": {
      "get": {
        "operationId": "getFlowSeries",
        "summary": "Flow metrics as a time series",
        "x-catalyst-schema-depth": "modeled",
        "x-catalyst-auth": "open",
        "security": [
          {
            "bearerKey": []
          },
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "repo",
            "required": true,
            "description": "Repository as owner/name",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "period",
            "description": "Time window; defaults to two weeks",
            "schema": {
              "type": "string",
              "enum": [
                "24h",
                "2d",
                "3d",
                "1w",
                "2w",
                "4w",
                "12w",
                "26w"
              ],
              "default": "2w"
            }
          },
          {
            "in": "query",
            "name": "granularity",
            "description": "Hour or calendar-day buckets. Omitted preserves period-derived widths: 1h for 24h, 2h for 2d, 3h for 3d, daily for week periods. Short periods by day include every calendar day touched; week periods keep their day count. The final bucket ends at the generation time. Explicit granularity or a new 12w/26w period is limited to 100,000 ticket age samples across current and previous buckets; exceeding this budget returns HTTP 400 (flow-series-too-large). Use daily buckets or a shorter period.",
            "schema": {
              "type": "string",
              "enum": [
                "hour",
                "day"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlowSeries"
                }
              }
            }
          }
        }
      }
    }
  },
