  "askTemplate": {
    "headings": {
      "ask": "**Ask:**",
      "options": "**Options:**",
      "defaultIfSilent": "**Default if silent:**",
      "howToAnswer": "**How to answer:**"
    },
    "howToAnswer": {
      "withOptions": "**How to answer:** reply in this thread with the option letter on its own (`A`), `(A)`, `option A`, or the option's own text pasted back. For an answer that is not on the list, reply `DECIDED: <your answer>`.",
      "withoutOptions": "**How to answer:** reply in this thread with `DECIDED: <your answer>` to record your decision."
    },
    "optionBulletFormat": "- **A** — <label>",
    "maxLetteredOptions": 26,
    "maxAskGenerations": 25,
    "example": "**Ask:** Should we adopt approach A or approach B?\n\nContext for the decision goes here.\n\n**Options:**\n- **A** — Option A\n- **B** — Option B\n\n**Default if silent:** Option A\n\n**How to answer:** reply in this thread with the option letter on its own (`A`), `(A)`, `option A`, or the option's own text pasted back. For an answer that is not on the list, reply `DECIDED: <your answer>`."
  },
  "ladder": {
    "phases": [
      "intake",
      "research",
      "plan",
      "implement",
      "validate",
      "pr",
      "remediate",
      "merge"
    ],
    "keying": "trailing",
    "keyingScope": "fleet",
    "intakeEnabled": true,
    "advance": [
      {
        "phase": "intake",
        "result": "ok",
        "fromSlots": null,
        "toSlot": null,
        "because": "CTC-1530 — intake's board moves (Todo→Intake at claim, Intake→Research on completion) are a PARALLEL mechanism (apps/mirror/src/do/intake-state-move.ts), never this table, for the same reason ADR-0069 gives for remediate: a move this table does not own must not desynchronize fromSlots matching here."
      },
      {
        "phase": "intake",
        "result": "failed",
        "fromSlots": null,
        "toSlot": null,
        "because": "a failed phase leaves the ticket retryable at its current stage — see CTC-955's failure comment"
      },
      {
        "phase": "research",
        "result": "ok",
        "fromSlots": [
          "dispatch"
        ],
        "toSlot": "research",
        "because": "the ticket leaves Todo the moment research lands"
      },
      {
        "phase": "research",
        "result": "failed",
        "fromSlots": null,
        "toSlot": null,
        "because": "a failed phase leaves the ticket retryable at its current stage — see CTC-955's failure comment"
      },
      {
        "phase": "plan",
        "result": "ok",
        "fromSlots": [
          "research"
        ],
        "toSlot": "plan",
        "because": "the plan artifact exists — the ticket moves into Plan"
      },
      {
        "phase": "plan",
        "result": "failed",
        "fromSlots": null,
        "toSlot": null,
        "because": "a failed phase leaves the ticket retryable at its current stage — see CTC-955's failure comment"
      },
      {
        "phase": "implement",
        "result": "ok",
        "fromSlots": [
          "plan"
        ],
        "toSlot": "implement",
        "because": "implementation commits landed — the ticket moves into Implement"
      },
      {
        "phase": "implement",
        "result": "failed",
        "fromSlots": null,
        "toSlot": null,
        "because": "a failed phase leaves the ticket retryable at its current stage — see CTC-955's failure comment"
      },
      {
        "phase": "validate",
        "result": "ok",
        "fromSlots": [
          "implement"
        ],
        "toSlot": "review",
        "because": "review and verify both collapse onto the tenant's Validate stage"
      },
      {
        "phase": "validate",
        "result": "failed",
        "fromSlots": null,
        "toSlot": null,
        "because": "a failed phase leaves the ticket retryable at its current stage — see CTC-955's failure comment"
      },
      {
        "phase": "pr",
        "result": "ok",
        "fromSlots": [
          "review"
        ],
        "toSlot": "pr",
        "because": "this row is what unblocks evaluateTicket's not_at_pr_stage gate"
      },
      {
        "phase": "pr",
        "result": "failed",
        "fromSlots": null,
        "toSlot": null,
        "because": "a failed phase leaves the ticket retryable at its current stage — see CTC-955's failure comment"
      },
      {
        "phase": "remediate",
        "result": "ok",
        "fromSlots": null,
        "toSlot": null,
        "because": "a remediate round fixes findings and resolves threads on an already-PR'd ticket — it is an interrupt, not a ladder step, and never advances workflow state; only merge moves the ticket past pr"
      },
      {
        "phase": "remediate",
        "result": "failed",
        "fromSlots": null,
        "toSlot": null,
        "because": "a failed phase leaves the ticket retryable at its current stage — see CTC-955's failure comment"
      },
      {
        "phase": "merge",
        "result": "ok",
        "fromSlots": [
          "pr"
        ],
        "toSlot": null,
        "because": "CTC-1187 — the merge PHASE succeeding means `queue:ready` was applied (apps/runner/src/executors/merge.ts: \"never 'PR merged'\"), not that the PR merged. Mergify can still dequeue it on a red Check (full). The terminal Done write is keyed to the real merge webhook instead — see resolveMergedPrAdvance below and ADR-20260902T031406."
      },
      {
        "phase": "merge",
        "result": "failed",
        "fromSlots": null,
        "toSlot": null,
        "because": "a failed phase leaves the ticket retryable at its current stage — see CTC-955's failure comment"
      }
    ]
