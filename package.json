{
  "name": "@catalyst-cloud/sdk",
  "version": "0.16.0",
  "description": "Read and update your Catalyst Cloud data, and receive live changes in your apps.",
  "license": "MIT",
  "author": "Coalesce Labs",
  "homepage": "https://github.com/coalesce-labs/catalyst-cloud-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coalesce-labs/catalyst-cloud-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/coalesce-labs/catalyst-cloud-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./browser/db-worker": {
      "types": "./dist/replica/browser/db.worker.d.ts",
      "import": "./dist/replica/browser/db.worker.js",
      "default": "./dist/replica/browser/db.worker.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js",
      "default": "./dist/events.js"
    },
    "./http": {
      "types": "./dist/tenant-client.d.ts",
      "import": "./dist/tenant-client.js",
      "default": "./dist/tenant-client.js"
    },
    "./live": {
      "types": "./dist/live-sync-client.d.ts",
      "import": "./dist/live-sync-client.js",
      "default": "./dist/live-sync-client.js"
    },
    "./replica/node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./replica/browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./replica/browser/db-worker": {
      "types": "./dist/replica/browser/db.worker.d.ts",
      "import": "./dist/replica/browser/db.worker.js",
      "default": "./dist/replica/browser/db.worker.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/replica/browser/db.worker.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-wire-types.mjs && node scripts/build-node.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "test:pack": "node scripts/verify-pack.mjs",
    "release:check": "node scripts/release-train-check.mjs && node --test scripts/release-train-check.test.mjs"
  },
  "keywords": [
    "catalyst",
    "websocket",
    "change-feed",
    "live-sync",
    "isomorphic",
    "cloudflare",
    "durable-objects"
  ],
  "devDependencies": {
    "@catalyst-cloud/read-model": "^0.16.0",
    "@catalyst-cloud/replicate": "0.16.0",
    "@catalyst-cloud/schema": "0.16.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-async-hooks": "^2.8.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-metrics": "^2.8.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "@types/node": "^26.2.0",
    "dts-bundle-generator": "^9.5.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.3.0 <2",
    "@sqlite.org/sqlite-wasm": "*",
    "better-sqlite3": "*",
    "@catalyst-cloud/read-model": "^0.16.0",
    "@catalyst-cloud/replicate": "0.16.0",
    "@catalyst-cloud/schema": "0.16.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "@sqlite.org/sqlite-wasm": {
      "optional": true
    },
    "@catalyst-cloud/read-model": {
      "optional": true
    },
    "@catalyst-cloud/replicate": {
      "optional": true
    },
    "@catalyst-cloud/schema": {
      "optional": true
    }
  }
}
